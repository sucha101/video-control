{
  "type": "object",
  "additionalProperties": false,
  "required": ["scenes"],
  "properties": {
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "prompt"],
        "properties": {
          "id": {"type": "integer", "minimum": 1, "maximum": 16},
          "prompt": {"type": "string", "minLength": 1, "maxLength": 4000},
          "narration": {"type": "string", "maxLength": 1000},
          "tag": {"type": "string", "maxLength": 100},
          "tagColor": {"type": "string", "maxLength": 30},
          "headlineCallout": {"type": "string", "maxLength": 100},
          "headlineColor": {"type": "string", "maxLength": 30},
          "pose": {"type": "string", "enum": ["host", "urgent", "shocked", "chill", "absent"]},
          "role": {"type": "string", "enum": ["reaction_overlay", "guide_sidecar", "presenter_full", "absent"]},
          "highlightWords": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}
